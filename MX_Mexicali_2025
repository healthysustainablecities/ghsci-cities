population:
  name: "Principales resultados por manzana urbana 2020 (INEGI, 2026)"
  data_dir: MX/mexicali_manzanas_population.geojson
  data_type: vector
  resolution: MZA
  vector_population_data_field: POBTOT
  population_denominator: POBTOT
  pop_min_threshold: 1
  crs_name: Mexico ITRF2008 / UTM zone 11N
  crs_standard: EPSG
  crs_srid: 6366
  source_url: https://www.inegi.org.mx/contenidos/programas/ccpv/iter/zip/resageburb20/resageburb_02csv20.zip
  year_published: 2026
  year_target: 2020
  date_acquired: 20260416
  licence: CC BY 4.0
  citation:  "INEGI (2026). Principales resultados por AGEB y manzana urbana 2020. https://www.inegi.org.mx/contenidos/programas/ccpv/iter/zip/resageburb20/resageburb_02csv20.zip."
  notes:  Spatial data containing AGEB population estimates were joined to AGEB geometries using official INEGI data.  After filtering to restrict to results for Mexicali, MZA population estimates were aggregated to AGEB areas and then linked to geometries before exporting as a geojson, as detailed in Mexicali_2025.ipynb. 
custom_aggregations:
  manzanas:
    ## path to data relative to project data folder
    data: "MX/mexicali_manzanas_population.geojson"
    ## The field used as a unique identifier
    id: MZA
    ## A list of column field names to be retained
    keep_columns: POBTOT
    ## The indicator layer to be aggregated ("point" or "grid")
    ## Aggregation is based on the average of intersecting results
    ## unless the agg_distance parameter is defined (see alternative example below)
    aggregation_source: point
    aggregate_within_distance: 30
    ## The variable used for weighting.
    ## Enter 'pop_est' to use the population grid.
    ## Leave blank or "false" if using sample points.
    weight: POBTOT
    notes:  Spatial data containing manzana (MZA) population estimates were joined to MZA geometries using official INEGI data, linking on AGEB and MZA (manzana) as detailed in Mexicali_2025.ipynb.  It is also worth noting that Manzanas are too fine-grained to aggregate meaningfully based on sample points alone; we need to use the 'aggregate_within_distance' argument from custom_aggregations.
OpenStreetMap:
  data_dir: MX/mexico-260409.osm.pbf
  source: Geofabrik GmbH
  publication_date: 20260410
  licence: ODbL
  url: https://download.geofabrik.de/north-america/mexico-latest.osm.pbf
  note: Mexico OpenStreetMap excerpt
network:
  ## NOTE: We want to retain gated communities in Mexicali, so we set this to true
  osmnx_retain_all: true
  ## Buffered region is not used for network extraction to ensure access is not inadvertently evaluated across the US border
  buffered_region: false
  ## Custom intersection data settings
  intersections:
    data: MX/INEGI/Red Nacional de Caminos-RNC-2025/conjunto_de_datos/rnc2025.gpkg:union_p
    citation: 'INEGI. 2025. Red Nacional de Caminos. RNC. 2025. https://en.www.inegi.org.mx/app/biblioteca/ficha.html?upc=794551163030'
    note: "Clean intersection locations from Mexico's official road infrastructure data, last updated 2025.  Manually verified using QGIS."
country_gdp:
